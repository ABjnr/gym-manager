@model GymManager.Models.MemberDetailsViewModel
@{
    ViewData["Title"] = "Member Details";
}
<h1>Member Details</h1>
<dl class="row">
    <dt class="col-sm-2">Name</dt>
    <dd class="col-sm-10">@Model.Member.FirstName @Model.Member.LastName</dd>
    <dt class="col-sm-2">Email</dt>
    <dd class="col-sm-10">@Model.Member.Email</dd>
    <dt class="col-sm-2">Phone</dt>
    <dd class="col-sm-10">@Model.Member.PhoneNumber</dd>
    <dt class="col-sm-2">Membership Type</dt>
    <dd class="col-sm-10">@Model.Member.MembershipType</dd>
    <dt class="col-sm-2">Join Date</dt>
    <dd class="col-sm-10">@Model.Member.JoinDate.ToShortDateString()</dd>
    <dt class="col-sm-2">Registered Classes</dt>
    <dd class="col-sm-10">
        @Model.ClassRegistrations.Count
        @if (Model.ClassRegistrations.Any())
        {
            <ul>
                @foreach (var reg in Model.ClassRegistrations)
                {
                    <li>@reg.GymClassName</li>
                }
            </ul>
        }
        else
        {
            <span>(None)</span>
        }
    </dd>
</dl>
<a asp-action="Edit" asp-route-id="@Model.Member.MemberId" class="btn btn-primary">Edit</a>
<a asp-action="Index" class="btn btn-secondary">Back to List</a>
