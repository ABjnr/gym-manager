@model GymManager.Models.PaymentDto
@{
    ViewData["Title"] = "Delete Payment";
}
<h1>Delete Payment</h1>
<h3>Are you sure you want to delete this payment?</h3>
<div>
    <dl class="row">
        <dt class="col-sm-2">Member</dt>
        <dd class="col-sm-10">@Model.MemberFullName</dd>
        <dt class="col-sm-2">Amount</dt>
        <dd class="col-sm-10">@Model.Amount.ToString("C")</dd>
        <dt class="col-sm-2">Method</dt>
        <dd class="col-sm-10">@Model.Method</dd>
        <dt class="col-sm-2">Date</dt>
        <dd class="col-sm-10">@Model.Date.ToShortDateString()</dd>
    </dl>
    <form asp-action="Delete" asp-route-id="@Model.PaymentId" method="post">
        <input type="hidden" asp-for="PaymentId" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
