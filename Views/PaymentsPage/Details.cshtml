@model GymManager.Models.PaymentDto
@{
    ViewData["Title"] = "Payment Details";
}
<h1>Payment Details</h1>
<dl class="row">
    <dt class="col-sm-2">Member</dt>
    <dd class="col-sm-10">@Model.MemberFullName</dd>
    <dt class="col-sm-2">Amount</dt>
    <dd class="col-sm-10">@Model.Amount.ToString("C")</dd>
    <dt class="col-sm-2">Method</dt>
    <dd class="col-sm-10">@Model.Method</dd>
    <dt class="col-sm-2">Date</dt>
    <dd class="col-sm-10">@Model.Date.ToShortDateString()</dd>
</dl>
<a asp-action="Edit" asp-route-id="@Model.PaymentId" class="btn btn-primary">Edit</a>
<a asp-action="Index" class="btn btn-secondary">Back to List</a>
