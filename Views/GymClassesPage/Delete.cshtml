@model GymManager.Models.GymClass
@{
    ViewData["Title"] = "Delete Gym Class";
}
<h1>Delete Gym Class</h1>
<h3>Are you sure you want to delete this gym class?</h3>
<div>
    <dl class="row">
        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.Name</dd>
        <dt class="col-sm-2">Trainer</dt>
        <dd class="col-sm-10">@Model.Trainer.FirstName @Model.Trainer.LastName</dd>
        <dt class="col-sm-2">Schedule Time</dt>
        <dd class="col-sm-10">@Model.ScheduleTime</dd>
        <dt class="col-sm-2">Max Capacity</dt>
        <dd class="col-sm-10">@Model.MaxCapacity</dd>
    </dl>
    <form asp-action="Delete" asp-route-id="@Model.GymClassId" method="post">
        <input type="hidden" asp-for="GymClassId" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
