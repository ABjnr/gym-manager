@model GymManager.Models.GymClassDetailsViewModel
@{
    ViewData["Title"] = "Gym Class Details";
}
<h1>Gym Class Details</h1>
<dl class="row">
    <dt class="col-sm-2">Name</dt>
    <dd class="col-sm-10">@Model.GymClass.Name</dd>
    <dt class="col-sm-2">Trainer</dt>
    <dd class="col-sm-10">@Model.GymClass.TrainerName</dd>
    <dt class="col-sm-2">Schedule Time</dt>
    <dd class="col-sm-10">@Model.GymClass.ScheduleTime</dd>
    <dt class="col-sm-2">Max Capacity</dt>
    <dd class="col-sm-10">@Model.GymClass.MaxCapacity</dd>
</dl>

<h3>Enrolled Students</h3>
@if (Model.EnrolledMembers.Any())
{
    <ul>
        @foreach (var reg in Model.EnrolledMembers)
        {
            <li>@reg.MemberFullName (@reg.RegistrationDate.ToShortDateString())</li>
        }
    </ul>
}
else
{
    <p><em>No students enrolled.</em></p>
}

<a asp-action="Edit" asp-route-id="@Model.GymClass.GymClassId" class="btn btn-primary">Edit</a>
<a asp-action="Index" class="btn btn-secondary">Back to List</a>
