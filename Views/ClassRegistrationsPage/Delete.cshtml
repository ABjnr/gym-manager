@model GymManager.Models.ClassRegistrationDto
@{
    ViewData["Title"] = "Delete Class Registration";
}
<h1>Delete Class Registration</h1>
<h3>Are you sure you want to delete this registration?</h3>
<div>
    <dl class="row">
        <dt class="col-sm-2">Member</dt>
        <dd class="col-sm-10">@Model.MemberFullName</dd>
        <dt class="col-sm-2">Gym Class</dt>
        <dd class="col-sm-10">@Model.GymClassName</dd>
        <dt class="col-sm-2">Registration Date</dt>
        <dd class="col-sm-10">@Model.RegistrationDate.ToShortDateString()</dd>
    </dl>
    <form asp-action="Delete" asp-route-id="@Model.ClassRegistrationId" method="post">
        <input type="hidden" asp-for="ClassRegistrationId" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
