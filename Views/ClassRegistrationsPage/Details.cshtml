@model GymManager.Models.ClassRegistrationDto
@{
    ViewData["Title"] = "Class Registration Details";
}
<h1>Class Registration Details</h1>
<dl class="row">
    <dt class="col-sm-2">Member</dt>
    <dd class="col-sm-10">@Model.MemberFullName</dd>
    <dt class="col-sm-2">Gym Class</dt>
    <dd class="col-sm-10">@Model.GymClassName</dd>
    <dt class="col-sm-2">Registration Date</dt>
    <dd class="col-sm-10">@Model.RegistrationDate.ToShortDateString()</dd>
</dl>
<a asp-action="Edit" asp-route-id="@Model.ClassRegistrationId" class="btn btn-primary">Edit</a>
<a asp-action="Index" class="btn btn-secondary">Back to List</a>
