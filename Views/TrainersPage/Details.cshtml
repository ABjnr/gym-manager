@model GymManager.Models.TrainerDto
@{
    ViewData["Title"] = "Trainer Details";
}
<h1>Trainer Details</h1>
<dl class="row">
    <dt class="col-sm-2">Name</dt>
    <dd class="col-sm-10">@Model.FirstName @Model.LastName</dd>
    <dt class="col-sm-2">Email</dt>
    <dd class="col-sm-10">@Model.Email</dd>
    <dt class="col-sm-2">Phone</dt>
    <dd class="col-sm-10">@Model.PhoneNumber</dd>
    <dt class="col-sm-2">Specialization</dt>
    <dd class="col-sm-10">@Model.Specialization</dd>
</dl>
<a asp-action="Edit" asp-route-id="@Model.TrainerId" class="btn btn-primary">Edit</a>
<a asp-action="Index" class="btn btn-secondary">Back to List</a>
