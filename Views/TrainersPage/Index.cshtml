@model IEnumerable<GymManager.Models.TrainerDto>
@{
    ViewData["Title"] = "Trainers";
}
<h1>Trainers</h1>
<p>
    <a asp-action="Create" class="btn btn-primary">Add Trainer</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Specialization</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.FirstName @item.LastName</td>
                <td>@item.Email</td>
                <td>@item.PhoneNumber</td>
                <td>@item.Specialization</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.TrainerId">Details</a> |
                    <a asp-action="Edit" asp-route-id="@item.TrainerId">Edit</a> |
                    <a asp-action="Delete" asp-route-id="@item.TrainerId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
